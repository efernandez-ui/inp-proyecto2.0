# Example environment variables (safe to commit)
# Copy this file to `.env.local` and fill the values you need.

# Port the app should run on (default: 3000)
PORT=3000

# Public API URL for client-side (must start with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Backend Spring (puerto 8081 en docker-compose). En `next dev` en el host suele ser http://localhost:8081
NEXT_PUBLIC_API_BACKEND=http://localhost:8081
# Solo servidor (proxy /api/*): en Docker Compose usar http://backend:8081
INTERNAL_API_URL=http://localhost:8081

# Server-side secret: do NOT commit the real secret
NEXTAUTH_SECRET=replace-me-with-a-secret

# Node environment
NODE_ENV=development
